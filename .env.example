# Frontend (optional today, reserved for future direct Supabase client usage)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Serverless API (required on Vercel for backend routes in /api)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional legacy key from AI Studio scaffold
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Marketplace backend (required for provider key encryption + cron sync)
ENCRYPTION_KEY=BASE64_32_BYTE_KEY
ENCRYPTION_KEY_VERSION=v1
CRON_SECRET=YOUR_CRON_SECRET

# Marketplace boost billing (Dodo - required for Pro/Elite boost checkout)
DODO_MARKETPLACE_API_KEY=YOUR_VIBEJAM_DODO_API_KEY
DODO_BOOST_PRO_PRODUCT_ID=YOUR_DODO_PRO_PRODUCT_ID
DODO_BOOST_ELITE_PRODUCT_ID=YOUR_DODO_ELITE_PRODUCT_ID
# Optional paid-tier toggle (set both vars to AURORA_RESTORE to re-enable Pro/Elite tiers)
MARKETPLACE_BOOSTS_UNLOCK_WORD=
VITE_MARKETPLACE_BOOSTS_UNLOCK_WORD=
# Optional override (defaults to https://api.dodopayments.com)
# DODO_API_BASE_URL=https://api.dodopayments.com

# Optional offer email delivery
RESEND_API_KEY=YOUR_RESEND_API_KEY
OFFERS_FROM_EMAIL=offers@vibejam.co
INBOX_FROM_EMAIL=inbox@vibejam.co
SUPPORT_EMAIL=vibejamco@gmail.com
ESCROW_EMAIL=broker@vibejam.co
ESCROW_API_KEY=YOUR_ESCROW_API_KEY
APP_BASE_URL=https://www.vibejam.co
